    "routeAssignment11": {
      "type": "object",
      "required": [
        "type",
        "definition",
        "geometryMode",
        "evidence"
      ],
      "properties": {
        "type": {
          "const": "Route"
        },
        "unit": {
          "const": "offense"
        },
        "definition": {
          "$ref": "#/$defs/routeDefinition11"
        },
        "geometryMode": {
          "enum": [
            "structured",
            "detected",
            "manual"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/routeEvidence11"
        }
      }
    },
    "routeDefinition11": {
      "allOf": [
        {
          "$ref": "#/$defs/routeDefinition"
        },
        {
          "type": "object",
          "required": [
            "alternatives",
            "activeAlternativeId"
          ],
          "properties": {
            "alternatives": {
              "description": "Up to four named alternative shapes (conversions), each a complete release/stem/breaks set.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/routeAlternative"
              }
            },
            "activeAlternativeId": {
              "description": "The id of the alternative whose geometry is currently shown, or null for the base route. Always resolves to an entry of `alternatives`.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "routeAlternative": {
      "type": "object",
      "required": [
        "id",
        "label",
        "when",
        "release",
        "stemYards",
        "breaks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "description": "The condition under which this shape is run, as prose.",
          "type": "string"
        },
        "release": {
          "enum": [
            "none",
            "inside",
            "outside",
            "best"
          ]
        },
        "stemYards": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "breaks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/routeBreak"
          }
        }
      }
    },
    "routeEvidence11": {
      "allOf": [
        {
          "$ref": "#/$defs/routeEvidence"
        },
        {
          "type": "object",
