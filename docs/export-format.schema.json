            "geometryBasis": {
              "description": "Where the drawn geometry came from. Known values: source-explicit, diagram-traced, neutral-animation, existing-diagram. Present on every non-coach-edited route.",
              "type": "string"
            },
            "sourcePositionLabel": {
              "description": "The position label in the source document, or null.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
