{
  "name": "football-os-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:unit": "node --test tests/play-data.test.mjs tests/workspace-data.test.mjs tests/field-view.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:browser": "node scripts/with-preview.mjs node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "test": "npm run test:unit && npm run test:sites && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
