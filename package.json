{
  "name": "football-os-coaching-workspace",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "npm run test:unit --prefix lesson && npm test --prefix practice && npm test --prefix packet",
    "test:sites": "npm run test:sites --prefix lesson",
    "build:editor": "npm run build --prefix lesson",
    "test:browser": "npm run test:browser --prefix lesson",
    "test:workflow": "npm run test:journey -- desktop && npm run test:journey -- phone && npm run test:cache",
    "test:journey": "node scripts/with-workspace.mjs node tests/browser/workspace-journey.mjs",
    "test:cache": "node scripts/with-workspace.mjs node tests/browser/workspace-cache-layout.mjs"
  }
}
